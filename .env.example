# Core Music Bot Configuration
# Made by rywax

# Discord Bot Token (ZORUNLU)
# Discord Developer Portal > Applications > Bot > Token
DISCORD_TOKEN=your_bot_token_here

# FFmpeg Path (varsayılan: ffmpeg)
# PATH'e eklediyseniz "ffmpeg" olarak bırakabilirsiniz
FFMPEG_PATH=ffmpeg

# Database Path (varsayılan: data/musicbot.db)
DATABASE_PATH=data/musicbot.db

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Development Guild ID (Opsiyonel)
# Test sunucunuzun ID'sini eklerseniz komutlar anında sync olur
# Boş bırakırsanız global sync yapılır (1 saate kadar sürebilir)
DEV_GUILD_ID=
